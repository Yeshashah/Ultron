# Ultron configuration. Copy this file to .env and edit the values.
# Never share or commit your .env file — it contains your API key.

# ---- AI -------------------------------------------------------------------
# "openai" (default) or "none" to disable AI answers (local commands still work).
AI_PROVIDER=openai
# Your API key from https://platform.openai.com/api-keys (leave empty to run without AI).
OPENAI_API_KEY=
# Any chat model your account can use. Defaults to gpt-4o-mini when empty.
OPENAI_MODEL=gpt-4o-mini
# Optional: base URL of an OpenAI-compatible service. Leave empty for OpenAI.
OPENAI_BASE_URL=
# Seconds to wait for an AI answer (5-120).
AI_TIMEOUT=30
# Maximum length of an AI answer, in tokens.
AI_MAX_TOKENS=500
# Creativity, 0.0 (focused) to 2.0 (random).
AI_TEMPERATURE=0.7
# How many recent messages are sent to the AI as conversation context (2-100).
MAX_HISTORY_MESSAGES=20

# ---- Voice output (text-to-speech) ---------------------------------------
# Speaking speed in words per minute (80-300).
TTS_RATE=175
# Volume from 0.0 to 1.0.
TTS_VOLUME=0.9
# Part of a voice name, e.g. "Zira" or "David" on Windows. Empty = system default.
TTS_VOICE=
# true = start with spoken replies muted.
START_MUTED=false

# ---- Voice input (speech recognition) ------------------------------------
# Language code: "en" (= en-US), or a full code such as en-GB, en-IN, hi-IN.
VOICE_LANGUAGE=en
# true = keep listening after each reply. Off by default; the UI always shows when the mic is active.
ENABLE_CONTINUOUS_MODE=false
# Seconds to wait for you to start speaking, and the maximum length of one phrase.
LISTEN_TIMEOUT=6
PHRASE_TIME_LIMIT=15

# ---- Web & apps -----------------------------------------------------------
# Quick factual answers for "look up ...": "none" (opens a Google search instead) or "duckduckgo".
WEB_SEARCH_PROVIDER=none
# Extra applications Ultron may open, as name=path pairs separated by semicolons.
# Only .exe and .lnk files are allowed on Windows. Example:
# ULTRON_APPS=paint=C:\Windows\System32\mspaint.exe;spotify=C:\Users\you\AppData\Roaming\Spotify\Spotify.exe
ULTRON_APPS=

# ---- Storage & logging ---------------------------------------------------------
# Folder for notes (relative paths are inside the project folder).
ULTRON_DATA_DIR=data
ULTRON_LOG_DIR=logs
# DEBUG, INFO, WARNING or ERROR. Secrets are always redacted from logs.
LOG_LEVEL=INFO
# dark, light or system
APPEARANCE_MODE=dark
# Port for the browser interface (python main.py --web). It only listens on 127.0.0.1.
WEB_PORT=8000
